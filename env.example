############################
# Общие настройки приложения
############################

# Окружение: dev/stage/prod
APP_ENV=dev
APP_NAME=TeamFinder
APP_VERSION=0.1.0

# Регион для AWS/Yandex Cloud (если используете S3-совместимое хранилище)
AWS_DEFAULT_REGION=ru-central1

############################
# Backend / База данных
############################

# Либо используйте DATABASE_URL, либо отдельные поля ниже
# DATABASE_URL=postgresql+asyncpg://teamfinder:teamfinder@postgres:5432/teamfinder

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=teamfinder
POSTGRES_USER=teamfinder
POSTGRES_PASSWORD=teamfinder

# CORS
CORS_ORIGINS=*

############################
# Auth / Telegram / JWT
############################

# Телеграм-бот, который используется Mini App (основной)
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Секрет для JWT (обязательно поменять в проде)
JWT_SECRET=dev-secret-change-me

# Админ-токен для защищенных ручек бэкенда
ADMIN_API_TOKEN=super-admin-token

# Имя бота и internal-имя приложения, используемые в deep-link'ах
TG_BOT_USERNAME=teamfinder_bot
TG_APP_NAME=tfapp

############################
# S3-совместимое хранилище
############################

# Endpoint провайдера (Yandex Cloud / MinIO / AWS S3 и т.п.)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=teamfinder
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY

# Публичный base-URL, по которому доступны файлы
S3_PUBLIC_BASE_URL=https://storage.yandexcloud.net/teamfinder

# Ограничения для загрузки обложек хакатонов
S3_HACKATHON_MAX_SIZE_MB=5
S3_HACKATHON_ALLOWED_TYPES=image/jpeg,image/png,image/webp

############################
# Frontend (Vite)
############################

# Базовый URL для запросов фронтенда к API
# Для локальной разработки (backend на 8000):
VITE_API_URL=http://localhost:8000/api/

# Для продакшена (пример):
# VITE_API_URL=https://teamfinder.tech/api/

############################
# Admin Bot (admin_bot/)
############################

# Токен отдельного админ-бота (для управления хакатонами)
ADMIN_BOT_TOKEN=0000000000:YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY

# Тот же ADMIN_API_TOKEN, который ожидает backend, для доступа к админ-ручкам
# (можно использовать то же значение, что и выше)
# ADMIN_API_TOKEN=super-admin-token

# Базовый URL API, куда стучится админ-бот
# В проде:
API_URL=https://teamfinder.tech/api/
# В dev:
# API_URL=http://localhost:8000/api/

# Список Telegram ID администраторов, через запятую
ADMIN_TELEGRAM_IDS=123456789,987654321

